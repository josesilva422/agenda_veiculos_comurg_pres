{
  "name": "agendamento_veiculo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:pg": "tsx scripts/e2e-postgres.ts",
    "e2e:relatorio": "playwright show-report",
    "db:deploy": "prisma migrate deploy",
    "db:pg:sync": "tsx scripts/pg-schema.ts",
    "db:pg:sql": "tsx scripts/pg-sql-editor.ts",
    "db:pg:deploy": "tsx scripts/pg-schema.ts && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "vercel-build": "tsx scripts/pg-schema.ts && prisma generate --schema prisma/postgres/schema.prisma && prisma migrate deploy --schema prisma/postgres/schema.prisma && next build",
    "admin:create": "tsx scripts/create-admin.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
