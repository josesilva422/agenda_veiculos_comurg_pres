# Copie para .env (desenvolvimento) ou .env.production (docker compose) e ajuste.

# Banco SQLite. Em Docker o valor padrão da imagem já é file:/data/app.db
DATABASE_URL="file:./dev.db"

# URL pública do sistema (com https em produção)
NEXTAUTH_URL="http://localhost:3000"

# Segredo da sessão: mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET=""

# Opcionais
# MIN_ANTECEDENCIA_MIN=30     # antecedência mínima (minutos) para solicitar
# BACKUP_DIR=./backups        # destino dos backups
# BACKUP_KEEP_DAYS=14         # retenção dos backups

# Atrás de um proxy reverso próprio que define x-forwarded-for (não precisa na Vercel): habilita o limite de login por IP.
# TRUST_PROXY=1

# --- Somente em produção na Vercel + Supabase (veja docs/DEPLOY.md) ---
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@<host>:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<senha>@<host>:5432/postgres
